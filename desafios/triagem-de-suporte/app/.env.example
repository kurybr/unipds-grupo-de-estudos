OPENROUTER_API_KEY=sk-or-v1-...

# Fallback global (usado quando o modelo do agente não está definido)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcional: um modelo por agente
OPENROUTER_MODEL_SUPERVISOR=openai/gpt-4o-mini
OPENROUTER_MODEL_COBRANCA=openai/gpt-4o-mini
OPENROUTER_MODEL_TECNICO=openai/gpt-4o-mini
OPENROUTER_MODEL_COMERCIAL=openai/gpt-4o-mini

# LangSmith / Studio (https://smith.langchain.com → Settings → API Keys)
LANGSMITH_API_KEY=lsv2_pt_...
# Opcional: traços no batch (npm start) e no Studio
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=triagem-de-suporte

# Máximo de visitas ao supervisor no loop (anti-loop)
SUPERVISOR_MAX_HOPS=5

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.localhost
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE=nome-da-instancia
# true se o certificado HTTPS local não for confiável (dev)
EVOLUTION_TLS_INSECURE=true

# Servidor webhook local
WEBHOOK_PORT=3000

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
